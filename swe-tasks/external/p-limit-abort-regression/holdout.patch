diff --git a/test-abort.js b/test-abort.js
new file mode 100644
--- /dev/null
+++ b/test-abort.js
@@ -0,0 +1,22 @@
+import {setTimeout as delay} from 'node:timers/promises';
+import test from 'ava';
+import pLimit from './index.js';
+test('pre-aborted work never runs', async t => {
+ const limit = pLimit(1); const c = new AbortController(); c.abort(Error('cancelled')); let ran = false;
+ await t.throwsAsync(limit.withSignal(c.signal, () => {ran = true}), {message: 'cancelled'});
+ t.false(ran); t.is(limit.pendingCount, 0);
+});
+test('queued abort removes only that item and preserves FIFO', async t => {
+ const limit = pLimit(1); const c = new AbortController(); const order = [];
+ const first = limit(async () => {await delay(20); order.push('first')});
+ const aborted = limit.withSignal(c.signal, () => order.push('aborted'));
+ const last = limit(() => order.push('last'));
+ t.is(limit.pendingCount, 2); c.abort(Error('cancelled')); t.is(limit.pendingCount, 1);
+ await t.throwsAsync(aborted, {message: 'cancelled'}); await Promise.all([first, last]);
+ t.deepEqual(order, ['first', 'last']);
+});
+test('abort after start leaves active work intact', async t => {
+ const limit = pLimit(1); const c = new AbortController();
+ const task = limit.withSignal(c.signal, async () => {await delay(5); return 42});
+ c.abort(Error('late')); t.is(await task, 42); t.is(limit.activeCount, 0);
+});
